# Copy to .env and fill in.  NEVER commit .env.

# ---------- LLM (Claude) ----------
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium            # low (fast/cheap) | medium | high | xhigh | max
CLAUDE_FALLBACKS=default        # server-side refusal fallback; leave empty to disable
ENABLE_WEB_SEARCH=true          # Anthropic-hosted web search + web fetch (about $10 per 1,000 searches; enable them for your org in the Console)

# ---------- Assistant ----------
DEFAULT_TIMEZONE=Asia/Kolkata   # used for reminders when no timezone is given

# ---------- Shared secret between services ----------
INTERNAL_API_KEY=change-me-internal-key
JARVIS_USER_ID=local            # whose data the CLI / MCP server / Streamlit use (your id is on the Account tab)

# ---------- Node gateway ----------
PORT=4000
MONGO_URI=mongodb://localhost:27017/jarvis
JWT_SECRET=replace-with-a-long-random-string
AI_SERVICE_URL=http://localhost:8001
CLIENT_ORIGINS=http://localhost:5173,http://localhost:3000
# Scaling (see docker-compose.yml and infra/aws/README.md)
# WEB_CONCURRENCY=1    # API worker processes in one container/terminal; "auto" = one per CPU core (needs MongoDB)
# API_REPLICAS=3       # docker compose: API containers behind the nginx load balancer
# API_WORKERS=2        # docker compose: WEB_CONCURRENCY for each of those containers
# DRAIN_MS=5000        # on shutdown, report "draining" this long before closing (production default 5000)

# Passkeys (sign in with Face ID / Touch ID / Windows Hello / fingerprint). Browsers allow them
# only on https:// addresses and localhost. List every address Azarvis is opened from, e.g.
# PASSKEY_ORIGINS=https://azarvis.example.com,http://localhost:5173  (default: CLIENT_ORIGINS)
# PASSKEY_RP_ID=azarvis.example.com   (optional: lets one passkey work on its subdomains too)
ADMIN_EMAILS=                   # comma-separated emails that get the admin role, e.g. you@example.com

# ---------- Banking-style authentication (Express API) ----------
ACCESS_TOKEN_TTL=15m            # short-lived JWT; renewed silently with the refresh cookie
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false             # true in production (HTTPS only)
LOGIN_OTP_REQUIRED=true         # 2-step login: password + one-time code
MAX_FAILED_LOGINS=5             # then the account is locked for LOCK_MINUTES
LOCK_MINUTES=15
AUTH_RATE_LIMIT=30              # auth requests per IP per 15 minutes

# ---------- OTP ----------
OTP_SECRET=replace-with-another-long-random-string
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN=60
OTP_PROVIDER=console            # console = print codes in the Express terminal; smtp = Gmail/SMTP email + Twilio SMS; aws = SES email + SNS SMS
DEMO_MODE=                      # true = show the verification code on the page instead of emailing it (quick public demo, no email service; anyone can register)
PASSWORD_ONLY=                  # true = plain email + password with no email service: no codes, addresses are not checked, ADMIN_EMAILS is ignored, password reset is off
APP_NAME=Aamir Jarvis Assistant # sender name shown in emails and messages
SYSTEM_CONTROL=true             # Jarvis may open apps/sites, change volume, lock, screenshot on THIS PC (false on servers)
SMTP_USER=                      # e.g. yourgmail@gmail.com (OTP_PROVIDER=smtp)
SMTP_PASS=                      # Gmail App Password (needs 2-Step Verification)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
TWILIO_ACCOUNT_SID=             # optional: real SMS (else SMS codes print in the terminal)
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=             # your Twilio number, E.164 e.g. +15551234567
SES_FROM_EMAIL=                 # verified SES sender, e.g. no-reply@yourdomain.com (OTP_PROVIDER=aws)

# ---------- AI service data ----------
# Empty = SQLite file in backend/fastapi-ai/data. For Postgres:
# DATABASE_URL=postgresql+psycopg://jarvis:jarvis@localhost:5432/jarvis
DATABASE_URL=
RAG_EMBEDDER=tfidf              # or sentence-transformers (pip install -r requirements-dl.txt)

# ---------- AWS (optional) ----------
# S3_BUCKET=my-jarvis-uploads
# AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=...         # locally only; use IAM roles on AWS
# AWS_SECRET_ACCESS_KEY=...

# ---------- SEO / Google Search Console (Docker builds) ----------
# Public addresses, no trailing slash. They go into canonical links, sitemap.xml and robots.txt.
# (Comments stay on their own lines: some .env readers keep a "# ..." after a blank value as the value.)
# The Jarvis app, e.g. https://jarvis.example.com
SITE_URL=
# The dashboard / landing page, e.g. https://www.jarvis.example.com
DASHBOARD_SITE_URL=
# Search Console > Add property > URL prefix > HTML tag: paste only the content="..." value.
GOOGLE_SITE_VERIFICATION=
# Google Analytics 4 > Admin > Data streams > Web: the measurement ID (G-XXXXXXXXXX). Empty = no analytics.
GA_ID=
