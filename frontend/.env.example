# Copy to frontend/.env (or set these at build time, e.g. as Docker build args).

# SEO. The public address of the app (no trailing slash). Used for the canonical link, link
# previews (Open Graph), sitemap.xml and robots.txt. Leave empty for local use.
VITE_SITE_URL=
# Google Search Console > Add property > URL prefix > HTML tag: paste only the content="..." value.
VITE_GOOGLE_SITE_VERIFICATION=
