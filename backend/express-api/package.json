{
  "name": "jarvis-express-api",
  "version": "2.0.0",
  "description": "Jarvis API gateway: Express + MongoDB. Banking-grade auth (OTP, lockout, refresh-token rotation), chat history, and proxy to the Python FastAPI AI service.",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch --env-file-if-exists=../../.env src/index.js",
    "test": "node --test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/client-sesv2": "^3.700.0",
    "@aws-sdk/client-sns": "^3.700.0",
    "@simplewebauthn/server": "13.3.3",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "http-proxy-middleware": "^3.0.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.0",
    "morgan": "^1.10.0",
    "multer": "^2.5.0",
    "nodemailer": "^6.10.1"
  }
}
