# Copy to .env.local for local overrides. On Vercel / Netlify / Cloudflare / AWS set these in
# the host's environment settings instead.

# Where the Express gateway (backend/express-api) runs. Read on the server only: the browser
# calls /api/* on this app, which proxies there. Must be a public URL when deployed, and must be
# set at BUILD time too: Next.js evaluates the /api rewrite while building.
BACKEND_URL=http://localhost:4000

# SEO. The public address of this site (no trailing slash). Canonical links, sitemap.xml,
# robots.txt and link previews are built from it at BUILD time.
NEXT_PUBLIC_SITE_URL=http://localhost:3001
# Google Search Console > Add property > URL prefix > HTML tag: paste only the content="..." value.
GOOGLE_SITE_VERIFICATION=
